{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>rishitank/.github:node"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "/^@orama/",
        "/^@modelcontextprotocol/",
        "/^fastify/",
        "/^vitest/",
        "/^zod/",
        "/^simple-git/"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": ["sqlite-vec", "tree-sitter", "tree-sitter-wasms"],
      "schedule": ["before 3am on Monday"],
      "reviewers": ["rishitank"],
      "assignees": ["rishitank"]
    }
  ]
}
